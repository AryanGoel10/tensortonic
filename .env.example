# ---- App URL + Auth.js (username/password sign-in) ----
NEXTAUTH_URL=http://localhost:3000            # production: https://tensortonic-outreach.vercel.app
NEXTAUTH_SECRET=                              # openssl rand -base64 32
# First accounts, created on deploy if missing (never overwritten). Add more people in Settings → Team.
BOOTSTRAP_USERS=                              # "aryan|Aryan|<password>;pratham|Pratham|<password>"

# ---- Google Sheets (service account with Editor access to each sheet) ----
GOOGLE_SERVICE_ACCOUNT_JSON=                  # base64 of the service account key file: base64 -w0 key.json

# ---- Database (Neon Postgres) ----
DATABASE_URL=

# ---- Background jobs (Inngest) ----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Override if the Vercel integration created a different Inngest account than the one you use:
TT_INNGEST_EVENT_KEY=
TT_INNGEST_SIGNING_KEY=

# ---- Research + writing ----
FIRECRAWL_API_KEY=
ANTHROPIC_API_KEY=                            # optional, paid. Writer order: Anthropic > Gemini > Vercel AI Gateway
GEMINI_API_KEY=                               # free tier: aistudio.google.com → Get API key (no card)
GEMINI_MODEL=                                 # optional; defaults to the newest Flash model the key can use
AI_GATEWAY_API_KEY=                           # optional: only needed for the gateway when running locally (on Vercel the project's OIDC token is used)
CLAUDE_MODEL=claude-sonnet-5-5                # or claude-haiku-5-5 (about 20x cheaper, lower quality)

# ---- Zoho Mail (pick the region your Zoho account lives in) ----
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in   # TensorTonic is on Zoho India (mx.zoho.in)
ZOHO_MAIL_API_BASE=https://mail.zoho.in       # or https://mail.zoho.com

# ---- Encryption for stored Zoho tokens ----
ENCRYPTION_KEY=                               # openssl rand -base64 32

# ---- Optional ----
SEND_TIMEZONE=Asia/Kolkata                    # daily cap resets and weekend rule use this timezone
