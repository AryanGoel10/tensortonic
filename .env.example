# ---- App URL + Auth.js ----
NEXTAUTH_URL=http://localhost:3000            # your Vercel URL in production, e.g. https://tt-outreach.vercel.app
NEXTAUTH_SECRET=                              # openssl rand -base64 32

# ---- Google sign-in (OAuth client) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Who can sign in ----
ALLOWED_DOMAIN=tensortonic.com                # anyone @tensortonic.com
ALLOWED_EMAILS=                               # plus these, comma-separated (e.g. a personal Gmail)

# ---- Google Sheets (service account with Editor access to each sheet) ----
GOOGLE_SERVICE_ACCOUNT_JSON=                  # base64 of the service account key file: base64 -w0 key.json

# ---- Database (Neon Postgres) ----
DATABASE_URL=

# ---- Background jobs (Inngest) ----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- Research + writing ----
FIRECRAWL_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ---- Zoho Mail (pick the region your Zoho account lives in) ----
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in   # or https://accounts.zoho.com
ZOHO_MAIL_API_BASE=https://mail.zoho.in       # or https://mail.zoho.com

# ---- Encryption for stored Zoho tokens ----
ENCRYPTION_KEY=                               # openssl rand -base64 32

# ---- Optional ----
SEND_TIMEZONE=Asia/Kolkata                    # daily cap resets and weekend rule use this timezone
